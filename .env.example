# Google 服务账号凭据（base64 编码的 JSON 文件）
# 必填。将 service account JSON 文件 base64 编码后填入
GOOGLE_CREDENTIALS_B64=your_base64_encoded_credentials_here

# Google Apps Script URL（可选，copy_file 需要）
# GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/xxx/exec

# 传输模式（可选，默认 stdio）
# MCP_TRANSPORT=stdio
# MCP_PORT=8000
